# Copy to backend/.env and fill in real values. backend/.env is gitignored --
# never commit it, never paste its contents into chat.

# --- Gemini (P0a-i default provider, all three roles) ---
GEMINI_API_KEY=
# Overrides for backend/spike/gemini_spike.py and (later) the Gemini
# adapters. Defaults are set in the script; only uncomment to override.
# GEMINI_LLM_MODEL=gemini-2.5-flash
# GEMINI_STT_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- OpenAI (P0a-ii alternate: STT + LLM) ---
# OPENAI_API_KEY=

# --- ElevenLabs (P0a-ii alternate: TTS) ---
# ELEVENLABS_API_KEY=

# --- Provider selection (env-switchable, see design doc Provider registry behavior) ---
# STT_PROVIDER=gemini
# LLM_PROVIDER=gemini
# TTS_PROVIDER=gemini
