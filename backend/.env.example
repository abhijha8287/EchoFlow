# Copy to backend/.env and fill in real values. backend/.env is gitignored --
# never commit it, never paste its contents into chat.

# --- Gemini (P0a-i default provider, all three roles) ---
GEMINI_API_KEY=
# Overrides for backend/spike/gemini_spike.py and (later) the Gemini
# adapters. Defaults are set in the script; only uncomment to override.
# GEMINI_LLM_MODEL=gemini-2.5-flash
# GEMINI_STT_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
#
# Pinned via backend/spike/gemini_spike.py (Assignment, Gemini leg), run
# 2026-07-29 against a quiet connection, synthetic 2s tone as the STT
# sample (not real speech):
#   LLM (gemini-2.5-flash): ~1.0-1.1s time to first token. Streams fine.
#   STT (gemini-2.5-flash, generateContent w/ inline audio Part): ~2.7-3.7s
#     total latency. chunk_count varied across repeated runs (1, then 2) --
#     this looks like transport-level chunking of one short response, not
#     confirmed incremental transcript growth (the transcript itself never
#     grew across chunks in what was observed). Treated as
#     supports_partial_streaming = False for the adapter regardless: the
#     chunked-upload path (see design doc STT algorithm) is correct and
#     safe either way, since it re-sends the full buffer each call rather
#     than assuming incremental content -- same as OpenAI's expected path.
#   TTS (gemini-2.5-flash-preview-tts): the model needs the text framed as
#     a read-aloud instruction ("Say: <text>") -- a plain sentence gets
#     treated as a chat prompt and the call fails with INVALID_ARGUMENT
#     since response_modalities=["AUDIO"] forbids a text reply.
#     ~4.5s time to first audio byte, and first-byte time == total
#     synthesis time (single chunk, not incrementally streamed) for one
#     short sentence. This is well over the ~1.5s TTFA stretch budget --
#     flagged, not silently accepted; needs a second real run (and
#     possibly a different API surface, e.g. the Live/bidi streaming API)
#     before trusting it as the P0a-i default's real number.
#   TTS output format (confirmed via a follow-up real call): raw PCM, no
#     container, mime_type "audio/L16;codec=pcm;rate=24000" -- i.e. s16le
#     mono 24kHz. The Gemini TTS adapter must resample 24000 -> 16000 via
#     utils/audio.normalize_audio() before sending on the wire (T6).

# --- OpenAI (P0a-ii alternate, all three roles: STT + LLM + TTS) ---
OPENAI_API_KEY=
# Overrides for the OpenAI adapters (backend/stt/openai.py, llm/openai.py,
# tts/openai.py). Defaults are set in each adapter; only uncomment to
# override.
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
#
# OpenAI TTS output format: response_format="pcm" returns raw PCM, no
# container, s16le mono 24kHz -- same native rate as Gemini's TTS output,
# so the OpenAI TTS adapter resamples 24000 -> 16000 via
# utils/audio.normalize_audio() before sending on the wire, same as Gemini.

# --- ElevenLabs (P0a-ii alternate: TTS) ---
# ELEVENLABS_API_KEY=

# --- Provider selection (env-switchable, see design doc Provider registry behavior) ---
# Each role independently picks "gemini" or "openai" at boot (backend/main.py).
# Only the API key(s) the selected provider(s) actually need are required --
# e.g. setting all three to openai never demands GEMINI_API_KEY.
# STT_PROVIDER=gemini
# LLM_PROVIDER=gemini
# TTS_PROVIDER=gemini
